    "main": ["com.dougg865.bloomberto.platform.fabric.BloombertoFabric"]
  },
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "${mc_range}",
    "java": ">=${java_version}",
    "fabric-api": "*"
  }
}
